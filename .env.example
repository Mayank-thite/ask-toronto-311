# Postgres (docker-compose.yml starts one with these settings)
ADMIN_DSN=postgresql://ask311:ask311@localhost:5432/toronto311
AGENT_DSN=postgresql://agent_ro:agent_ro@localhost:5432/toronto311

# Any OpenAI-compatible endpoint. Default: Ollama on this machine.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=not-needed-for-local

# Optional: Claude instead of a local model (python -m ask311 "..." --claude)
# ANTHROPIC_API_KEY=your-key-here
